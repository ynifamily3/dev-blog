---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts, groupTags, tagUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const tags = groupTags(posts);
---

<BaseLayout>
  <div class="page-container home-page">
    <div class="eyebrow"><span class="eyebrow-dot"></span> Development notes</div>
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">생각을 코드로,<br /><span>코드를 문서로.</span></h1>
      <p>개발하며 배우고 확인한 내용을 차근차근 기록합니다.</p>
    </section>

    <div class="section-heading">
      <div>
        <p class="section-kicker">01 / WRITING</p>
        <h2>글</h2>
      </div>
      <span class="section-count">{posts.length.toString().padStart(2, '0')} ARTICLES</span>
    </div>

    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">✳</span>
        <h3>첫 글을 준비 중입니다.</h3>
        <p>작성한 글이 발행되면 이곳에 표시됩니다.</p>
      </div>
    )}

    {tags.length > 0 && (
      <section class="home-tags" aria-labelledby="home-tags-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">02 / TOPICS</p>
            <h2 id="home-tags-title">주제</h2>
          </div>
          <a class="text-link" href="/tags/">모든 태그 보기 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="tag-cloud">
          {tags.map(({ label, posts }) => (
            <a class="tag-chip" href={tagUrl(label)}>{label} <span>{posts.length}</span></a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
