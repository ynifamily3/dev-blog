---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" indexable={false}>
  <div class="page-container not-found">
    <p class="section-kicker">404 / NOT FOUND</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소를 다시 확인하거나 글 목록으로 돌아가세요.</p>
    <a class="text-link" href="/">글 목록으로 돌아가기 <span aria-hidden="true">↗</span></a>
  </div>
</BaseLayout>
